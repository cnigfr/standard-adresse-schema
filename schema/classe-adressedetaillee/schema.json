{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "adressedetaillee",
  "title": "Adresse Détaillée",
  "description": "Adresse détaillée intégrant des composants permettant l'adressage à l'intérieur d'un bâtiment",
  "keywords": ["adresse", "local", "appartement"],
  "countryCode": "FR",
  "homepage": "https://github.com/cnigfr/schema-adresse",
  "path": "https://github.com/cnigfr/schema-adresse/raw/main/schema/adressedetaillee/schema.json",
  "resources": [{
    "title": "Fichier valide",
    "path": "https://github.com/cnigfr/schema-adresse/raw/main/schema/adressedetaillee/exemple-valide.csv"
  }],
  "created": "2026-08-07",
  "version": "v1.0.0",
  "contributors": [{
    "title": "Membres du GT Adresses du CNIG",
    "email": "cnig@cnig.fr",
    "organisation": "CNIG",
    "role": "author"
  }],
  "fields": [
    {
      "name": "idAdresseDetaillee",
      "title": "Identifiant adresse détaillée",
      "description": "Identifiant unique de l'adresse détaillée",
      "type": "string",
      "format": "uuid",
      "constraints": {
        "required": true,
		"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "example": "2979a822-9cc7-459f-8d32-d7658e39d6c0"
    },
    {
      "name": "idAdresseCommunale",
      "title": "Identifiant adresse communale",
      "description": "Identifiant de l'adresse communale à laquelle cette adresse détaillée est rattachée (mutuellement exclusif avec idAdresseComplementaire)",
      "type": "string",
      "format": "uuid",
      "constraints": {
        "required": false,
		"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "example": "2979a822-9cc7-459f-8d32-d7658e39d6c0"
    },
    {
      "name": "idAdresseComplementaire",
      "title": "Identifiant adresse complémentaire",
      "description": "Identifiant de l'adresse complémentaire à laquelle cette adresse détaillée est rattachée (mutuellement exclusif avec idAdresseCommunale)",
      "type": "string",
      "format": "uuid",
      "constraints": {
        "required": false,
		"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "example": "2979a822-9cc7-459f-8d32-d7658e39d6c0"
    }
  ],
  "foreignKeys": [
    {
      "fields": ["idAdresseCommunale"],
      "reference": {
        "resource": "adressecommunale",
        "fields": ["idAdresseCommunale"]
      }
    },
    {
      "fields": ["idAdresseComplementaire"],
      "reference": {
        "resource": "adressecomplementaire",
        "fields": ["idAdresseComplementaire"]
      }
    }
  ],
  "primaryKey": ["idAdresseDetaillee"]
}